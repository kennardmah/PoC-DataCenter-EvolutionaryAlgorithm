        self.hotspot_penalty_factor = 0.1
        self.hotspot_lookahead_window = 6

    def _calculate_operation_score(self, server_id, start_time):
        compute_cost = sum(self.inst.server_cost[server_id][t % self.inst.time_horizon]
                           for t in range(start_time, start_time + self.op.duration))

        projected_completion = start_time + self.op.duration + self.remaining_duration
        delay = max(0, projected_completion - self.job.deadline)
        delay_penalty = delay * self.job.delay_weight

        wait_time = start_time - self.earliest_start
        # Base procrastination penalty scaled by job urgency
        procrastination_penalty = (wait_time * self.base_procrastination_penalty *
                                   self.urgency.procrastination_penalty_multiplier)

        # Incorporate Multi-Operation Impact into Procrastination Penalty (Recommendation 5)
        if self.num_remaining_operations > 0:
            # Slack for the entire *remaining* job after current operation completes
            job_final_slack = self.job.deadline - (start_time + self.op.duration + self.remaining_duration)

            # Define a critical slack threshold based on remaining duration and number of ops
            # More remaining ops or longer ops means a slightly higher buffer is desired
            critical_slack_buffer = self.remaining_duration + (self.num_remaining_operations * 0.5)

            multi_op_impact_penalty = 0.0
            if job_final_slack < critical_slack_buffer:
                # If slack is less than the critical buffer, apply an exponential penalty
                # The closer the slack is to zero (or negative), the steeper the penalty
                slack_shortfall = max(0, critical_slack_buffer - job_final_slack)

                # The exponent base determines how steeply the penalty grows.
                # Higher urgency and smaller remaining duration (making future ops more vulnerable)
                # should lead to a steeper penalty.
                # Clamp to avoid extremely large or small bases from edge cases.
                exponent_base = 0.1 + (0.02 * self.urgency.urgency_score) # Base sensitivity by urgency
                if self.remaining_duration > 0:
                    exponent_base += (0.03 * self.num_remaining_operations) / self.remaining_duration # More ops/shorter duration -> steeper

                multi_op_impact_penalty = (math.exp(slack_shortfall * exponent_base) - 1.0) * self.job.delay_weight * 0.5

            procrastination_penalty += multi_op_impact_penalty


        load_penalty = 0.0
        server = self.inst.servers[server_id]
        if not server.is_cloud:
            # Look ahead from current operation start, not just after operation end
            for t in range(start_time, start_time + self.op.duration + self.hotspot_lookahead_window):
                used = self.capacity_usage.get(server_id, {}).get(t, 0)
                available = get_available_capacity(self.inst, server_id, t)
                if available > 0:
                    current_utilization = (used + self.op.capacity_required) / available
                    # Apply a quadratic penalty for high utilization, kicks in above 70%
                    if current_utilization > 0.7:
                        load_penalty += (current_utilization - 0.7) ** 2 * self.hotspot_penalty_factor * 20 # Increased factor for impact

            # Scale total load penalty by job urgency
            load_penalty *= self.urgency.urgency_score

        return (compute_cost * self.inst.weights['compute_cost'] +
                delay_penalty * self.inst.weights['delay_penalty'] +
                procrastination_penalty + load_penalty)
