def _find_best_local_placement(self, op: Operation, server: Server, earliest_start: int) -> Optional[Placement]:
        """Finds the best time slot for an operation on a local server."""
        deadline = op.job.deadline

        # Limit search to a reasonable horizon based on slack
        # Proportional to slack, but capped by deadline
        slack = deadline - earliest_start - op.duration
        search_horizon = earliest_start + int(self.slack_ratio * slack)
        search_horizon = max(earliest_start, min(deadline - op.duration, search_horizon))

        for t in range(earliest_start, search_horizon + 1):
            if server.can_schedule(t, op.duration):
                score = self._calculate_operation_score(op, server, t, earliest_start)
                return Placement(op, server, t, score)

        return None
```

