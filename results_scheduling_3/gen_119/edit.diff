+class ScoringHeuristics:
+    """A collection of static methods for calculating placement cost components."""
+    PRIORITY_PROCRASTINATION_MULTIPLIER = {'critical': 8.0, 'urgent': 4.0, 'high': 2.0, 'medium': 1.0, 'low': 0.5}
+    BASE_PROCRASTINATION_PENALTY_FACTOR = 0.05
+    LOAD_PENALTY_FACTOR = 5.0
+    PRIORITY_LOAD_MULTIPLIER = {"emergency": 0.1, "critical": 0.2, "high": 0.5, "medium": 1.0, "low": 2.0}
+    LOCAL_PREFERENCE_BONUS = -10.0
+
+    @staticmethod
+    def calculate_total_score(context: SchedulingContext, job: Job, op: Operation, server_id: str, start_time: int, earliest_start: int, rem_duration: int) -> float:
+        server = context.inst.servers[server_id]
+        compute_cost = ScoringHeuristics._compute_cost(context, server_id, start_time, op.duration)
+        delay_cost = ScoringHeuristics._delay_cost(context, job, start_time, op.duration, rem_duration)
+        procrastination_penalty = ScoringHeuristics._procrastination_penalty(context, job, start_time, earliest_start, op.duration, rem_duration)
+        load_penalty = 0.0
+        if not server.is_cloud:
+            load_penalty = ScoringHeuristics._load_penalty(context, job, server_id, start_time, op.duration)
+        
+        total_score = (compute_cost * context.inst.weights['compute_cost'] + delay_cost + procrastination_penalty + load_penalty)
+        if not server.is_cloud:
+            total_score += ScoringHeuristics.LOCAL_PREFERENCE_BONUS
+        return total_score
+
+    @staticmethod
+    def _compute_cost(ctx: SchedulingContext, server_id: str, start: int, dur: int) -> float:
+        return sum(ctx.inst.server_cost[server_id][t % ctx.inst.time_horizon] for t in range(start, start + dur))
+
+    @staticmethod
+    def _delay_cost(ctx: SchedulingContext, job: Job, start: int, op_dur: int, rem_dur: int) -> float:
+        delay = max(0, start + op_dur + rem_dur - job.deadline)
+        return delay * job.delay_weight * ctx.inst.weights['delay_penalty']
+
+    @staticmethod
+    def _procrastination_penalty(ctx: SchedulingContext, job: Job, start: int, earliest: int, op_dur: int, rem_dur: int) -> float:
+        slack = job.deadline - (earliest + op_dur + rem_dur)
+        urgency_mult = ScoringHeuristics.PRIORITY_PROCRASTINATION_MULTIPLIER.get(job.priority, 1.0)
+        slack_ratio = 1.0
+        if slack < 0:
+            slack_ratio = 1.0 + (math.exp(abs(slack) / (ctx.inst.time_horizon / 4.0)) - 1.0)
+        elif slack < ctx.inst.time_horizon / 4:
+            ratio = (ctx.inst.time_horizon / 4.0 - slack) / (ctx.inst.time_horizon / 4.0)
+            slack_ratio = 1.0 + (ratio ** 2) * 2.0
+        return ScoringHeuristics.BASE_PROCRASTINATION_PENALTY_FACTOR * (start - earliest) * urgency_mult * slack_ratio
+
+    @staticmethod
+    def _load_penalty(ctx: SchedulingContext, job: Job, server_id: str, start: int, dur: int) -> float:
+        win_start, win_end = max(0, start - dur), start + dur * 2
+        util, steps = 0.0, 0
+        for t in range(win_start, win_end):
+            used = ctx.capacity_usage.get(server_id, {}).get(t, 0)
+            avail = ctx.get_capacity(server_id, t)
+            if avail > 0: util += used / avail
+            steps += 1
+        if steps > 0:
+            avg_util = util / steps
+            load_mult = ScoringHeuristics.PRIORITY_LOAD_MULTIPLIER.get(job.priority, 1.0)
+            return avg_util * ScoringHeuristics.LOAD_PENALTY_FACTOR * load_mult * job.delay_weight
+        return 0.0
