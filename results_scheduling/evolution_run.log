def _find_best_local_slot(self, op: Operation, earliest_start: int, job: Job, last_scheduled_server: Optional[str]) -> Optional[Tuple[int, str]]:
        """
        Finds the best local slot based on earliest start, then cost, then remaining capacity,
        then preference for same server for critical jobs.
        Returns (start_time, server_id) or None.
        """
        local_servers = self.local_servers_by_type.get(op.server_type, [])

        candidates = [] # Stores (start_time, cost_for_op, neg_remaining_capacity_after_op, same_server_penalty, server_id)

        for server_id in local_servers:
            # Prioritize local servers that are less congested in the *immediate future*
            # This is a heuristic to try to spread load. Reorder based on anticipated capacity usage.
            # However, for simplicity and performance with existing precomputation, we iterate as is.
            # A more advanced lookahead would involve estimating future availability.

            for start_time_candidate in range(earliest_start, self.inst.time_horizon):
                if self._has_capacity(server_id, start_time_candidate, op.duration, op.capacity_required):
                    cost_candidate = self._calculate_operation_compute_cost(server_id, start_time_candidate, op.duration)

                    # Calculate remaining capacity sum across the duration
                    remaining_capacity_sum = self._calculate_remaining_capacity_sum(
                        server_id, start_time_candidate, op.duration, op.capacity_required
                    )

                    # Preference for same server for CRITICAL/HIGH priority jobs (Recommendation 5)
                    same_server_penalty = 1 if server_id != last_scheduled_server else 0
                    if job.priority_score > self.priority_map["HIGH"]: # Only apply for CRITICAL/HIGH
                        same_server_penalty = 1 # Not a critical/high job, no preference for same server

                    candidates.append((
                        start_time_candidate,
                        cost_candidate,
                        -remaining_capacity_sum, # Negate to sort descending (more remaining is better)
                        same_server_penalty,
                        server_id # Last for deterministic tie-breaking by ID
                    ))
                    break # Found earliest slot for THIS server, move to next server

        if candidates:
            # Sort candidates based on criteria:
            # 1. Earliest start_time (ascending)
            # 2. Lowest cost (ascending)
            # 3. Highest remaining capacity sum (descending, hence -remaining_cap_sum ascending)
            # 4. Same server preference (0 before 1) for critical/high jobs
            # 5. Server ID (ascending) for deterministic tie-breaking
            best_candidate = sorted(candidates)[0]
            return (best_candidate[0], best_candidate[4]) # Return (start_time, server_id)
        return None
```

