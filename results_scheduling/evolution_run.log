        current_op_start_time = job_available_time[job_id]

        for op_idx, op in enumerate(job.operations):
            best_total_objective_cost = float('inf')
            chosen_server = None
            chosen_start = None

            # 1. Evaluate local machines
            local_servers = [s.id for s in inst.servers.values() if s.server_type == op.server_type and not s.is_cloud]
            for server_id in local_servers:
                # Iterate through possible start times up to the time horizon,
                # but also consider job deadline for this specific operation.
                search_end_time = min(inst.time_horizon, latest_start_time_to_meet_deadline + 1)

                for start_time in range(current_op_start_time, search_end_time):
                    if has_capacity(server_id, start_time, op.duration, op.capacity_required):
                        current_cost_estimate = _get_op_schedule_cost(
                            server_id, start_time, op.duration, op.capacity_required, job_id, op_idx
                        )
                        if current_cost_estimate < best_total_objective_cost:
                            best_total_objective_cost = current_cost_estimate
                            chosen_server = server_id
                            chosen_start = start_time
                        # Continue searching to find the *best* local slot, not just the *earliest*

            # If no local slot found or if local option causes deadline violation, consider cloud
            if best_schedule_option["server"] is None or \
               (best_schedule_option["start"] + op.duration > job.deadline and job.deadline < inst.time_horizon):

                cloud_server_id = None
                for s_id in get_servers_by_type(op.server_type, prefer_local=False):
                    if inst.servers[s_id].is_cloud:
                        cloud_server_id = s_id
                        break

                if cloud_server_id:
                    # Cloud has unlimited capacity, can schedule immediately at current_op_start_time
                    cloud_start_time = current_op_start_time
                    cloud_op_cost = 0
                    for t in range(cloud_start_time, cloud_start_time + op.duration):
                        cloud_op_cost += inst.server_cost[cloud_server_id][t % inst.time_horizon]

                    # Prioritize cloud if it resolves deadline issues or is just better
                    # This is a heuristic to decide if cloud is preferred over a *very late* local slot
                    # For critical jobs, cloud might be preferred even if local is available later
                    if best_schedule_option["server"] is None or \
                       cloud_start_time + op.duration <= job.deadline or \
                       job.priority_score >= priority_map["HIGH"] : # High priority jobs might preemptively go to cloud
                        best_schedule_option["server"] = cloud_server_id
                        best_schedule_option["start"] = cloud_start_time
                        best_schedule_option["cost"] = cloud_op_cost
                        best_schedule_option["is_cloud"] = True

            # Execute the best chosen option (local or cloud)
            final_server = best_schedule_option["server"]
            final_start = best_schedule_option["start"]

            # Fallback if no option was found (should not happen with cloud)
            if final_server is None:
                # This indicates a problem if cloud was not found, or it was deemed worse
                # For robustness, we'll force the first cloud server at earliest_start
                cloud_server_id = None
                for s_id in get_servers_by_type(op.server_type, prefer_local=False):
                    if inst.servers[s_id].is_cloud:
                        cloud_server_id = s_id
                        break
                final_server = cloud_server_id if cloud_server_id else compatible_local_servers[0] # Fallback to local if no cloud for some reason
                final_start = current_op_start_time

            # Reserve capacity
            for t in range(final_start, final_start + op.duration):
                if t not in capacity_usage[final_server]:
                    capacity_usage[final_server][t] = 0
                capacity_usage[final_server][t] += op.capacity_required

            schedule[job_id].append({"server": final_server, "start": final_start})
            current_op_start_time = final_start + op.duration
            job_available_time[job_id] = current_op_start_time # Update for next operations of this job
