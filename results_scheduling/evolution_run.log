# Track when each job can start (max of arrival time and previous operation finish time)
    job_available_time = {j: inst.jobs[j].arrival_time for j in inst.jobs}

    schedule = {}

    # Pre-calculate total duration for each job and priority scores
    priority_map = {"CRITICAL": 4, "HIGH": 3, "MEDIUM": 2, "LOW": 1}
    for job_id, job in inst.jobs.items():
        job.total_duration = sum(op.duration for op in job.operations)
        # Add a priority score attribute to the job for easier sorting
        job.priority_score = priority_map.get(job.priority, 0)


    # Priority-Aware Job Ordering:
    # Sort by:
    # 1. Priority (CRITICAL > HIGH > MEDIUM > LOW) (descending)
    # 2. Urgency / Slack (deadline - (arrival + total_duration) * delay_weight) (ascending)
    # 3. Delay weight (higher delay weight first) - multiplied by -1 to sort descending
    # 4. Arrival time (ascending)
    # 5. Job ID (for consistent tie-breaking)
    sorted_jobs = sorted(inst.jobs.keys(),
                         key=lambda j_id: (
                             -inst.jobs[j_id].priority_score,  # Higher priority first
                             inst.jobs[j_id].deadline - inst.jobs[j_id].arrival_time - inst.jobs[j_id].total_duration, # Smaller slack first
                             -inst.jobs[j_id].delay_weight, # Higher delay weight first
                             inst.jobs[j_id].arrival_time,  # Earlier arrival as tie-breaker
                             j_id  # Final tie-breaker
                         ))

    for job_id in sorted_jobs:
        job = inst.jobs[job_id]
        schedule[job_id] = []

        current_op_start_time = job_available_time[job_id] # Earliest start for the current operation

        for op_idx, op in enumerate(job.operations):
            compatible_local_servers = get_servers_by_type(op.server_type, prefer_local=True)
            compatible_local_servers = [s_id for s_id in compatible_local_servers if not inst.servers[s_id].is_cloud]

            best_schedule_option = {
                "server": None,
                "start": -1,
                "cost": float('inf'),
                "is_cloud": False
            }

            # Calculate the latest start time for this operation to meet the job's deadline
            # considering remaining operations
            remaining_duration = sum(j_op.duration for j_op in job.operations[op_idx+1:])
            latest_start_time_to_meet_deadline = job.deadline - remaining_duration - op.duration

            # Search for the best local slot
            for server_id in compatible_local_servers:
                # Search window: from current_op_start_time up to the time horizon,
                # but also consider job deadline for this specific operation.
                search_end_time = min(inst.time_horizon, latest_start_time_to_meet_deadline + 1)

                for start_time in range(current_op_start_time, search_end_time):
                    if has_capacity(server_id, start_time, op.duration, op.capacity_required):
                        op_cost = 0
                        for t in range(start_time, start_time + op.duration):
                            op_cost += inst.server_cost[server_id][t % inst.time_horizon]

                        if op_cost < best_schedule_option["cost"]:
                            best_schedule_option["server"] = server_id
                            best_schedule_option["start"] = start_time
                            best_schedule_option["cost"] = op_cost
                            best_schedule_option["is_cloud"] = False

            # If no local slot found or if local option causes deadline violation, consider cloud
            if best_schedule_option["server"] is None or \
               (best_schedule_option["start"] + op.duration > job.deadline and job.deadline < inst.time_horizon):

                cloud_server_id = None
                for s_id in get_servers_by_type(op.server_type, prefer_local=False):
                    if inst.servers[s_id].is_cloud:
                        cloud_server_id = s_id
                        break

                if cloud_server_id:
                    # Cloud has unlimited capacity, can schedule immediately at current_op_start_time
                    cloud_start_time = current_op_start_time
                    cloud_op_cost = 0
                    for t in range(cloud_start_time, cloud_start_time + op.duration):
                        cloud_op_cost += inst.server_cost[cloud_server_id][t % inst.time_horizon]

                    # Prioritize cloud if it resolves deadline issues or is just better
                    # This is a heuristic to decide if cloud is preferred over a *very late* local slot
                    # For critical jobs, cloud might be preferred even if local is available later
                    if best_schedule_option["server"] is None or \
