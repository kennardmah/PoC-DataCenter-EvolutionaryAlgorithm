best_local_server_info = {
                "server": None,
                "start": -1,
                "total_score": float('inf')
            }

            cloud_server_id = self.cloud_servers_by_type.get(op.server_type)

            search_window_start = max(earliest_start_for_op, 0)
            search_window_end = self.inst.time_horizon

            # Step 1: Search for the best local slot first, considering cost, delay, and failure
            for server_id in compatible_servers:
                server = self.inst.servers[server_id]
                if server.is_cloud:
                    continue

                for start_time in range(search_window_start, search_window_end):
                    if not self._has_capacity_for_op(server_id, start_time, op.duration, op.capacity_required):
                        continue

                    op_cost = self._calculate_operation_cost(server_id, start_time, op.duration)
                    potential_completion_time = start_time + op.duration

                    delay = max(0, potential_completion_time - job.deadline)
                    delay_penalty = delay * job.delay_weight * self.inst.weights["delay_penalty"]

                    # Proactive failure avoidance: penalize scheduling in failing machines
                    failure_penalty = 0.0
                    if self.inst.machine_failures:
                        for f in self.inst.machine_failures:
                            if f.machine_id == server_id and f.failure_start <= start_time < f.failure_end:
                                failure_overlap_duration = min(potential_completion_time, f.failure_end) - max(start_time, f.failure_start)
                                if failure_overlap_duration > 0:
                                    # Higher penalty for critical jobs and significant capacity reductions
                                    current_capacity = self._get_current_available_capacity(server_id, start_time)
                                    if current_capacity < op.capacity_required: # If at start it already fails, penalize heavily
                                        failure_penalty += 1000 * job.priority_score # Extreme penalty
                                    else:
                                        # Penalty proportional to capacity reduction and how critical the job is
                                        effective_reduction_factor = f.capacity_reduction / server.capacity
                                        failure_penalty += effective_reduction_factor * op.duration * job.delay_weight * 5 * job.priority_score

                    total_local_score = (op_cost * self.inst.weights["compute_cost"]) + delay_penalty + failure_penalty

                    if total_local_score < best_local_server_info["total_score"]:
                        best_local_server_info["total_score"] = total_local_score
                        best_local_server_info["server"] = server_id
                        best_local_server_info["start"] = start_time
                    elif total_local_score == best_local_server_info["total_score"]:
                        # Tie-breaking: prefer earlier start time if scores are equal
                        if start_time < best_local_server_info["start"]:
                            best_local_server_info["start"] = start_time
